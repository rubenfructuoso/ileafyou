# i leaf you auf Hosttech (Apache): Dateitypen für die PWA richtig ausliefern
AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# App-Dateien bei jedem Start beim Server prüfen, sonst bleiben Updates im Browser-Cache hängen
# (Schriften und Bilder dürfen im Cache bleiben)
<FilesMatch "\.(html|js|css|json)$|^$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

# Server-Dateien, die nicht direkt aufgerufen werden sollen
<FilesMatch "^(lib\.php|webpush\.php|reminders\.php|config\.php|config\.example\.php|.*\.sqlite)$">
  Require all denied
</FilesMatch>
